{
  "build-system": {
    "requires": [
      "setuptools>=61.0"
    ],
    "build-backend": "setuptools.build_meta"
  },
  "project": {
    "name": "tradingagents",
    "dynamic": [
      "version"
    ],
    "description": "TradingAgents: Multi-Agents LLM Financial Trading Framework",
    "readme": "README.md",
    "requires-python": ">=3.11",
    "dependencies": [
      "cryptography>=42.0",
      "langchain-core>=1.6.5",
      "langchain-anthropic>=1.7.4",
      "langchain-google-genai>=4.4.0",
      "langchain-openai>=1.6.6",
      "langgraph>=1.2.12",
      "langgraph-checkpoint-sqlite>=3.1.1",
      "markdown-it-py>=4.0",
      "packaging>=24.0",
      "pandas>=3.0.6",
      "python-dotenv>=1.0.0",
      "pytz>=2025.2",
      "questionary>=2.1.0",
      "requests>=2.32.4",
      "rich>=14.0.0",
      "typer>=0.21.0",
      "stockstats>=0.6.5",
      "typing-extensions>=4.14.0",
      "yfinance>=1.7.0"
    ],
    "optional-dependencies": {
      "dev": [
        "ruff>=0.16",
        "pytest>=8.0",
        "pytest-subtests>=0.13"
      ],
      "bedrock": [
        "langchain-aws>=1.7.9"
      ]
    },
    "scripts": {
      "tradingagents": "cli.main:app"
    }
  },
  "tool": {
    "setuptools": {
      "dynamic": {
        "version": {
          "attr": "tradingagents.__version__"
        }
      },
      "packages": {
        "find": {
          "include": [
            "tradingagents*",
            "cli*"
          ]
        }
      },
      "package-data": {
        "cli": [
          "static/*"
        ],
        "tradingagents": [
          "assets/*.svg"
        ]
      }
    },
    "pytest": {
      "ini_options": {
        "testpaths": [
          "tests"
        ],
        "addopts": "-ra --strict-markers -m \"not integration\"",
        "markers": [
          "unit: fast isolated unit tests",
          "integration: tests requiring external services; run only when asked for, with -m integration",
          "smoke: quick sanity-check tests"
        ],
        "filterwarnings": [
          "ignore::DeprecationWarning"
        ]
      }
    },
    "ruff": {
      "line-length": 100,
      "target-version": "py311",
      "extend-exclude": [
        "results"
      ],
      "lint": {
        "select": [
          "E",
          "W",
          "F",
          "I",
          "B",
          "UP",
          "C4",
          "SIM"
        ],
        "ignore": [
          "E501"
        ],
        "per-file-ignores": {
          "**/__init__.py": [
            "F401"
          ]
        },
        "isort": {
          "combine-as-imports": true
        }
      }
    }
  }
}